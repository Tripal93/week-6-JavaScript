<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SpendWise — Expense Tracker</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <main class="app">
    <header class="app-header">
      <h1>SpendWise</h1>
      <p class="subtitle">Track your daily expenses and monitor your spending</p>
    </header>

    <section class="summary-card" aria-label="Spending Summary">
      <div>
        <span class="summary-label">Total Spent</span>
        <strong id="total-spent" class="summary-value">KES 0.00</strong>
      </div>
      <div>
        <span class="summary-label">Entries</span>
        <strong id="expense-count" class="summary-value">0</strong>
      </div>
    </section>

    <section class="form-card" aria-label="Add Expense">
      <form id="expense-form" novalidate>
        <div class="field">
          <label for="expense-title">Expense Name</label>
          <input
            type="text"
            id="expense-title"
            placeholder="e.g., Transport, Lunch, Groceries"
            required
          />
        </div>

        <div class="field">
          <label for="expense-amount">Amount (KES)</label>
          <input
            type="number"
            id="expense-amount"
            placeholder="e.g., 250"
            step="0.01"
            min="0.01"
            required
          />
        </div>

        <div class="field">
          <label for="expense-category">Category</label>
          <select id="expense-category">
            <option value="Transport">Transport</option>
            <option value="Food">Food</option>
            <option value="Shopping">Shopping</option>
            <option value="Utilities">Utilities</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <button type="submit" class="btn-primary">Add Expense</button>
      </form>
      <p id="feedback-message" class="feedback" role="status" aria-live="polite"></p>
    </section>

    <section class="list-card" aria-label="Expense List">
      <div class="list-header">
        <h2>Recorded Expenses</h2>
        <button type="button" id="clear-all-btn" class="btn-secondary">Clear All</button>
      </div>
      <ul id="expense-list" class="expense-list"></ul>
    </section>
  </main>

  <script src="script.js"></script>
</body>
</html>
